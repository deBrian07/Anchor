{
  "name": "rejoin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "python3 -m uvicorn main:app --app-dir server --reload --host 127.0.0.1 --port 8000",
    "start": "concurrently -n api,web -c cyan,magenta \"npm run api\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
